{{> header }}

<div class="container">

    <h1>{{title}}</h1>

    {{#each trips}}

    <div class="trip">

        <img src="/{{image}}" alt="{{name}}">

        <h2>{{name}}</h2>

        <p>{{description}}</p>

        <p>
            Length: {{length}}
        </p>

        <p>
            Starting Date: {{start}}
        </p>

        <p>
            Resort: {{resort}}
        </p>

        <p>
            Price: {{perPerson}}
        </p>

    </div>

    {{/each}}

</div>

{{> footer }}